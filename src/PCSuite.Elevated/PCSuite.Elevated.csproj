<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- El helper reutiliza registro/operaciones/IPC tal cual los define
         Infrastructure: una sola copia de la lógica de la lista blanca. -->
    <ProjectReference Include="..\PCSuite.Infrastructure\PCSuite.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- WinExe: sin ventana de consola parpadeando mientras vive el hijo.
         TFM -windows: el helper es Windows de raíz (SCM, registro, UAC) —
         además anota el ensamblado y el analizador calla los CA1416 de
         las operaciones Windows-only que registra. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Mismo icono que la app: es el que muestra el prompt UAC. -->
    <ApplicationIcon>..\PCSuite.Desktop\PCSuite.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
