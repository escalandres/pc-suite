<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PCSuite.Application\PCSuite.Application.csproj" />
    <ProjectReference Include="..\PCSuite.Infrastructure\PCSuite.Infrastructure.csproj" />
    <ProjectReference Include="..\PCSuite.Core\PCSuite.Core.csproj" />
    <ProjectReference Include="..\PCSuite.Contracts\PCSuite.Contracts.csproj" />

    <!-- Solo para orden de build: el helper se copia junto al ejecutable
         más abajo (Task 005); su ensamblado no se referencia. -->
    <ProjectReference Include="..\PCSuite.Elevated\PCSuite.Elevated.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Task 005: PCSuite.Elevated.exe debe quedar al lado de la app para que
       ElevationManager pueda lanzarlo con runas (misma configuración). -->
  <Target Name="CopyElevatedHelper" AfterTargets="Build">
    <ItemGroup>
      <_ElevatedHelperFiles Include="..\PCSuite.Elevated\bin\$(Configuration)\net10.0\**\*.*"
                            Exclude="..\PCSuite.Elevated\bin\$(Configuration)\net10.0\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_ElevatedHelperFiles)"
          DestinationFiles="@(_ElevatedHelperFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>