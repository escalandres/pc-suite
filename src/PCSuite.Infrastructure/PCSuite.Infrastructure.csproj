<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PCSuite.Application\PCSuite.Application.csproj" />
    <ProjectReference Include="..\PCSuite.Core\PCSuite.Core.csproj" />
    <ProjectReference Include="..\PCSuite.Contracts\PCSuite.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Keys\ManifestSigningKey.asc" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <!-- El parser de tablas winget, el validador de argumentos y los códigos de
       salida son internos: se exponen a los tests sin hacerlos públicos.
       SignRelease (Task 19.6) usa el ctor interno de ManifestSignatureVerifier
       para su modo de verificación sin tocar el TOFU del usuario. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PCSuite.Application.Tests" />
    <InternalsVisibleTo Include="SignRelease" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
